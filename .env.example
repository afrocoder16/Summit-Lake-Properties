# Copy to .env and fill in. Never commit .env.
# PUBLIC_ variables are bundled into the browser build by design (static hosting).

# Final site address, used for canonical links, Open Graph and the sitemap.
# Falls back to http://localhost:4321 when empty.
SITE_URL=

# Sub-path when hosted under a folder, such as /Summit-Lake-Properties on GitHub Pages. Leave empty for a domain root.
BASE_PATH=

# EmailJS (maintenance request form). Leave empty to run the form in sample mode.
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=
# Separate EmailJS template for home inquiries and tour requests on the vacancies page.
PUBLIC_EMAILJS_INQUIRY_TEMPLATE_ID=

# Published Google Sheet CSV with PUBLIC vacancy info only. Never tenant or applicant data.
PUBLIC_VACANCIES_CSV_URL=

# Google Form for rental applications.
PUBLIC_APPLY_FORM_URL=
