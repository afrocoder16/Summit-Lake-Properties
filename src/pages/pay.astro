---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PayFlow from '../components/PayFlow.astro';
import Icon from '../components/Icon.astro';
import { site, phoneHref, managerName, href } from '../config/site';
---
<Base title="Pay rent" description={`Pay your ${site.name} rent online by bank transfer or card, or set up autopay. Questions? Call ${managerName} at ${site.phone}.`}>
  <PageHero id="pay" eyebrow="Pay rent" title="Pay your rent online" lead="Choose your home, pick how to pay and you are done in about a minute. No account needed.">
    <p class="mt-6 inline-flex items-center gap-2 text-sky"><Icon name="lock" class="h-5 w-5" />Payments are handled by Stripe. We never see your bank or card details.</p>
  </PageHero>

  <section class="section" aria-label="Pay rent">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-[1fr_20rem] lg:items-start">
        <PayFlow />

        <aside class="space-y-5 lg:sticky lg:top-24" aria-label="Other ways to pay and help">
          <div class="card-mist p-6">
            <p class="font-display text-xl font-bold text-lake">Why pay online?</p>
            <ul class="mt-3 space-y-2">
              <li class="flex gap-3"><Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-shore" />Paid on time, with an emailed receipt</li>
              <li class="flex gap-3"><Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-shore" />No password to remember</li>
              <li class="flex gap-3"><Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-shore" />Bank transfer has no fee to you</li>
            </ul>
          </div>
          <div class="card-mist p-6">
            <p class="font-display text-xl font-bold text-lake">Prefer to mail a check?</p>
            <p class="mt-1">Send it to {site.mailing.poBox}, {site.mailing.city}, {site.mailing.state} {site.mailing.zip}. <a href={href('/tenants#pay-rent')} class="font-semibold text-lake underline">See mailing details</a>.</p>
          </div>
          <div class="card-mist p-6">
            <p class="font-display text-xl font-bold text-lake">Need help?</p>
            <p class="mt-1">Call <a href={phoneHref} class="font-semibold text-lake underline">{managerName} at {site.phone}</a> with any payment question.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
