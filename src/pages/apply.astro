---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site, phoneHref, managerName, href } from '../config/site';
import { env } from '../config/env';

const formUrl = env.applyFormUrl;
---
<Base title="Apply" description={`Apply for a home with ${site.name}. ${formUrl ? 'Start the online application.' : `Call ${managerName} at ${site.phone} to apply.`}`}>
  <PageHero id="apply" eyebrow="Apply" title="Apply for a home" lead={formUrl ? 'Start your application online when you are ready.' : `The easiest way to apply right now is to call ${managerName}.`} />

  <section class="section" aria-labelledby="apply-title">
    <div class="container-x grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="card p-7 md:p-10">
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-glow text-ink"><Icon name={formUrl ? 'form' : 'phone'} /></span>
        {formUrl ? (
          <>
            <h2 id="apply-title" class="mt-5 text-3xl sm:text-4xl">Start your application</h2>
            <p class="mt-3 text-lg">The application opens in a Google Form in a new tab.</p>
            <a href={formUrl} class="btn btn-glow mt-6 w-full sm:w-auto" target="_blank" rel="noopener noreferrer">Open the application</a>
            <p class="mt-5">Questions first? Call <a href={phoneHref} class="font-semibold text-lake underline">{managerName} at {site.phone}</a>.</p>
          </>
        ) : (
          <>
            <h2 id="apply-title" class="mt-5 text-3xl sm:text-4xl">Call {managerName} to apply</h2>
            <p class="mt-3 text-lg">Call to ask about available homes and how to apply.</p>
            <a href={phoneHref} class="btn btn-glow mt-6 w-full sm:w-auto"><Icon name="phone" class="h-5 w-5" />Call {managerName} {site.phone}</a>
          </>
        )}
        <p class="mt-6 text-sm text-muted">See what is open on the <a href={href('/vacancies')} class="font-semibold text-lake underline">vacancies page</a>.</p>
      </div>

      <aside class="rounded-3xl border-2 border-lake bg-mist p-7 md:p-9" aria-labelledby="privacy-title">
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-lake text-white"><Icon name="shield" /></span>
        <h2 id="privacy-title" class="mt-5 text-2xl sm:text-3xl">Protect your privacy</h2>
        <p class="mt-3 text-lg">Please do not send Social Security numbers by email or text. Keep sensitive details out of messages, and ask {managerName} how to share them safely.</p>
      </aside>
    </div>
  </section>
</Base>
