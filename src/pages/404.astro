---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { phoneHref, site, managerName, href } from '../config/site';
---
<Base title="Page not found" description="That page could not be found.">
  <PageHero id="nf" title="We could not find that page" lead="It may have moved, or the link may be mistyped.">
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={href('/')} class="btn btn-glow">Go to the home page</a>
      <a href={phoneHref} class="btn btn-line-light">Call us {site.phone}</a>
    </div>
  </PageHero>
</Base>
