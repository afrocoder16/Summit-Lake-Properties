---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import PhotoSlider from '../components/PhotoSlider.astro';
import HomeViewer from '../components/HomeViewer.astro';
import { site, phoneHref, managerName, href, smsHref } from '../config/site';
import { env } from '../config/env';
import { sampleVacancies } from '../config/sample';

const url = env.vacanciesCsvUrl;
---
<Base title="Vacancies" description={`Current vacancies from ${site.name} in ${site.city}, ${site.state}. Call us at ${site.phone} with questions.`}>
  <PageHero id="vacancies" eyebrow="Vacancies" title="Available homes" lead="Current openings, listed as they come up." />

  <section class="section" aria-labelledby="vac-title" id="vacancies-root" data-csv-url={url ?? ''}>
    <div class="container-x">
      <h2 id="vac-title" class="sr-only">Current vacancies</h2>

      <!-- Loading -->
      {url && (
        <div data-state="loading" role="status" aria-live="polite" class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          <span class="sr-only">Loading vacancies</span>
          {[0, 1, 2].map(() => <div class="card h-52 animate-pulse bg-mist" aria-hidden="true"></div>)}
        </div>
      )}

      <!-- Results -->
      <ul data-state="results" class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" hidden></ul>

      <!-- Design sample: shown only while no vacancy sheet URL is set. A real sheet replaces it. -->
      {!url && (
        <div data-sample>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow">Preview of what is coming</p>
              <p class="mt-3 max-w-xl">These homes are made up to show how the page will look. Real openings will appear here as soon as they are posted.</p>
            </div>
            <div role="group" aria-label="Filter by bedrooms" class="grid grid-cols-3 gap-2 sm:flex sm:flex-wrap">
              {[['all', 'All homes'], ['1', '1 bedroom'], ['2', '2 bedrooms']].map(([value, label], i) => (
                <button type="button" data-filter={value} aria-pressed={i === 0 ? 'true' : 'false'} class="filter-chip justify-center !px-2 text-[0.92rem] sm:!px-4 sm:text-[0.97rem]">{label}</button>
              ))}
            </div>
          </div>

          <ul class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {sampleVacancies.map((v) => (
              <li data-beds={v.beds} class="card flex flex-col overflow-hidden">
                <div class="relative">
                  <PhotoSlider photos={v.photos} label={`Photos of ${v.unit}`} eager />
                  <span class="pointer-events-none absolute left-4 top-4 rounded-full bg-glow px-3 py-1 text-xs font-bold uppercase tracking-wide text-ink">Sample listing</span>
                </div>
                <div class="flex grow flex-col p-6">
                  <h3 class="text-2xl">{v.unit}</h3>
                  <ul class="mt-3 flex flex-wrap gap-2">
                    <li class="rounded-full bg-mist px-3 py-1 text-sm font-semibold text-lake">{v.bedrooms} bed</li>
                    <li class="rounded-full bg-mist px-3 py-1 text-sm font-semibold text-lake">{v.bathrooms} bath</li>
                  </ul>
                  <p class="mt-4 font-display text-3xl font-bold text-lake">${v.rent} per month</p>
                  <p class="mt-1 text-sm font-semibold text-muted">Available {v.available}</p>
                  <p class="mt-4 grow">{v.details}</p>
                  <div class="mt-5 grid gap-3">
                    <button type="button" data-open-home={`home-${v.id}`} class="btn btn-lake"><Icon name="image" class="h-5 w-5" />Photos and contact</button>
                    <a href={smsHref(`Hi ${managerName}, I'm interested in ${v.unit} at $${v.rent} a month. Is it still available?`)} class="btn btn-line"><Icon name="message" class="h-5 w-5" />Text us</a>
                  </div>
                </div>
              </li>
            ))}
          </ul>
          {sampleVacancies.map((v) => <HomeViewer home={v} />)}
          <p data-filter-empty class="mt-6 text-center text-lg" hidden>No sample homes match that filter.</p>

          <!-- How posting will work. Pitch aid for the owner; delete this block to remove. -->
          <div class="card-mist mt-14 p-7 md:p-10">
            <p class="eyebrow">How new openings get posted</p>
            <h2 class="mt-4 text-2xl sm:text-3xl">Add a home in about a minute</h2>
            <ol class="mt-6 grid gap-5 md:grid-cols-3">
              {[
                ['form', 'Fill in a short form', 'Unit, bedrooms, rent, move-in date and a few details.'],
                ['sparkle', 'It shows up here', 'The new home appears on this page automatically.'],
                ['check', 'Mark it rented', 'Change the status and it comes off the page.'],
              ].map(([icon, title, text], i) => (
                <li class="flex gap-4">
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-lake font-display text-lg font-bold text-white">{i + 1}</span>
                  <span>
                    <span class="flex items-center gap-2 font-display text-lg font-bold text-lake"><Icon name={icon as 'form' | 'sparkle' | 'check'} class="h-5 w-5" />{title}</span>
                    <span class="mt-1 block">{text}</span>
                  </span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      )}

      <!-- Empty (shown only when a sheet is set but has no rows) -->
      <div data-state="empty" class="mx-auto max-w-xl text-center" hidden>
        <svg viewBox="0 0 240 150" class="mx-auto h-40 w-auto" aria-hidden="true" focusable="false">
          <circle cx="170" cy="46" r="14" fill="var(--glow)" />
          <path d="M10 118 78 36l38 48 22-24 60 58z" fill="var(--sky)" />
          <path d="M78 36l16 20M116 84l14-16" stroke="var(--shore)" stroke-width="2" fill="none" stroke-linecap="round" />
          <path d="M0 126c20-8 30-8 50 0s30 8 50 0 30-8 50 0 30 8 50 0 30-8 40-4v28H0z" fill="var(--lake)" />
          <path d="M24 138c10-4 16-4 26 0M96 140c10-4 16-4 26 0M168 138c10-4 16-4 26 0" stroke="var(--sky)" stroke-width="2" fill="none" stroke-linecap="round" />
        </svg>
        <h2 class="mt-4 text-3xl">No vacancies right now</h2>
        <p class="mt-3 text-lg">Nothing is listed at the moment. Call us to ask about availability.</p>
        <a href={phoneHref} class="btn btn-lake mt-6"><Icon name="phone" class="h-5 w-5" />Call us {site.phone}</a>
      </div>

      <!-- Error -->
      <div data-state="error" role="alert" class="mx-auto max-w-xl rounded-3xl border-2 border-glow bg-[#FFF6E0] p-7 text-center" hidden>
        <h2 class="text-2xl">We could not load the vacancy list</h2>
        <p class="mt-2">Please try again in a moment, or call us for what is available.</p>
        <a href={phoneHref} class="btn btn-lake mt-5"><Icon name="phone" class="h-5 w-5" />Call us {site.phone}</a>
      </div>

      <noscript>
        <p class="mt-6 text-center">Turn on JavaScript to see the vacancy list, or call <a href={phoneHref} class="font-semibold text-lake underline">us at {site.phone}</a>.</p>
      </noscript>

      <p class="mx-auto mt-12 max-w-xl text-center">
        Want to see a home in person? <a href={phoneHref} class="font-semibold text-lake underline">Call us at {site.phone}</a> or use <strong>Photos and contact</strong> on any home to send a message or request a tour.
      </p>
    </div>
  </section>
</Base>

<script>
  import { loadVacancies, vacancyCard } from '../lib/vacancies';

  const root = document.getElementById('vacancies-root');
  const url = root?.dataset.csvUrl;

  // Bedroom filter for the design sample listings.
  const sample = root?.querySelector<HTMLElement>('[data-sample]');
  if (sample) {
    const chips = sample.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = sample.querySelectorAll<HTMLElement>('[data-beds]');
    const none = sample.querySelector<HTMLElement>('[data-filter-empty]')!;
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        let shown = 0;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        cards.forEach((card) => {
          const match = chip.dataset.filter === 'all' || card.dataset.beds === chip.dataset.filter;
          card.hidden = !match;
          if (match) shown++;
        });
        none.hidden = shown > 0;
      }),
    );
  }

  if (root && url) {
    const show = (name: string) =>
      root.querySelectorAll<HTMLElement>('[data-state]').forEach((n) => (n.hidden = n.dataset.state !== name));
    loadVacancies(url)
      .then((rows) => {
        if (!rows.length) return show('empty');
        const list = root.querySelector<HTMLElement>('[data-state="results"]')!;
        list.replaceChildren(...rows.map(vacancyCard));
        show('results');
      })
      .catch(() => show('error'));
  }
</script>
