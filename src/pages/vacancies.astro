---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site, phoneHref, managerName, href } from '../config/site';
import { env } from '../config/env';

const url = env.vacanciesCsvUrl;
---
<Base title="Vacancies" description={`Current vacancies from ${site.name} in ${site.city}, ${site.state}. Call ${managerName} at ${site.phone} with questions.`}>
  <PageHero id="vacancies" eyebrow="Vacancies" title="Available homes" lead="Current openings, listed as they come up." />

  <section class="section" aria-labelledby="vac-title" id="vacancies-root" data-csv-url={url ?? ''}>
    <div class="container-x">
      <h2 id="vac-title" class="sr-only">Current vacancies</h2>

      <!-- Loading -->
      {url && (
        <div data-state="loading" role="status" aria-live="polite" class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          <span class="sr-only">Loading vacancies</span>
          {[0, 1, 2].map(() => <div class="card h-52 animate-pulse bg-mist" aria-hidden="true"></div>)}
        </div>
      )}

      <!-- Results -->
      <ul data-state="results" class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" hidden></ul>

      <!-- Empty (also the no URL state) -->
      <div data-state="empty" class="mx-auto max-w-xl text-center" hidden={Boolean(url)}>
        <svg viewBox="0 0 240 150" class="mx-auto h-40 w-auto" aria-hidden="true" focusable="false">
          <circle cx="170" cy="46" r="14" fill="var(--glow)" />
          <path d="M10 118 78 36l38 48 22-24 60 58z" fill="var(--sky)" />
          <path d="M78 36l16 20M116 84l14-16" stroke="var(--shore)" stroke-width="2" fill="none" stroke-linecap="round" />
          <path d="M0 126c20-8 30-8 50 0s30 8 50 0 30-8 50 0 30 8 50 0 30-8 40-4v28H0z" fill="var(--lake)" />
          <path d="M24 138c10-4 16-4 26 0M96 140c10-4 16-4 26 0M168 138c10-4 16-4 26 0" stroke="var(--sky)" stroke-width="2" fill="none" stroke-linecap="round" />
        </svg>
        <h2 class="mt-4 text-3xl">No vacancies right now</h2>
        <p class="mt-3 text-lg">Nothing is listed at the moment. Call {managerName} to ask about availability.</p>
        <a href={phoneHref} class="btn btn-lake mt-6"><Icon name="phone" class="h-5 w-5" />Call {managerName} {site.phone}</a>
      </div>

      <!-- Error -->
      <div data-state="error" role="alert" class="mx-auto max-w-xl rounded-3xl border-2 border-glow bg-[#FFF6E0] p-7 text-center" hidden>
        <h2 class="text-2xl">We could not load the vacancy list</h2>
        <p class="mt-2">Please try again in a moment, or call {managerName} for what is available.</p>
        <a href={phoneHref} class="btn btn-lake mt-5"><Icon name="phone" class="h-5 w-5" />Call {managerName} {site.phone}</a>
      </div>

      <noscript>
        <p class="mt-6 text-center">Turn on JavaScript to see the vacancy list, or call <a href={phoneHref} class="font-semibold text-lake underline">{managerName} at {site.phone}</a>.</p>
      </noscript>

      <p class="mx-auto mt-12 max-w-xl text-center">
        Ready to apply? <a href={href('/apply')} class="font-semibold text-lake underline">Start your application</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  import { loadVacancies, vacancyCard } from '../lib/vacancies';

  const root = document.getElementById('vacancies-root');
  const url = root?.dataset.csvUrl;
  if (root && url) {
    const show = (name: string) =>
      root.querySelectorAll<HTMLElement>('[data-state]').forEach((n) => (n.hidden = n.dataset.state !== name));
    loadVacancies(url)
      .then((rows) => {
        if (!rows.length) return show('empty');
        const list = root.querySelector<HTMLElement>('[data-state="results"]')!;
        list.replaceChildren(...rows.map(vacancyCard));
        show('results');
      })
      .catch(() => show('error'));
  }
</script>
