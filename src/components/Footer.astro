---
import { site, phoneHref, managerName, nav, href } from '../config/site';
import Logo from './Logo.astro';
---
<footer class="on-dark bg-deep text-sky pb-24 md:pb-0">
  <div class="container-x grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1.2fr]">
    <div>
      <p class="text-white"><Logo /></p>
      <p class="mt-4 max-w-sm text-[0.95rem] leading-relaxed">{site.goal}</p>
    </div>
    <nav aria-label="Footer">
      <p class="font-display font-semibold text-white">Pages</p>
      <ul class="mt-3 space-y-1">
        {nav.map((item) => (
          <li><a href={href(item.href)} class="inline-block py-1.5 hover:text-white">{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div>
      <p class="font-display font-semibold text-white">Reach {managerName}</p>
      <ul class="mt-3 space-y-2 text-[0.95rem]">
        <li><a href={phoneHref} class="inline-block py-1.5 text-lg font-semibold text-glow">{site.phone}</a></li>
        <li>
          {site.mailing.poBox}<br />
          {site.mailing.city}, {site.mailing.state} {site.mailing.zip}
        </li>
        {site.email && <li><a href={`mailto:${site.email}`} class="underline underline-offset-4">{site.email}</a></li>}
        {site.officeHours && <li>{site.officeHours}</li>}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="container-x py-4 text-xs">Sample website by Midvora. {site.name}, {site.city}, {site.state}.</p>
  </div>
</footer>
