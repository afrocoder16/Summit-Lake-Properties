---
import Icon from './Icon.astro';
import { site, phoneHref, managerName } from '../config/site';
import { payUnits, payDueText, cardFee, payHistory } from '../config/sample';

const money = (n: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(n);
---
<div
  id="pay-app"
  data-units={JSON.stringify(payUnits)}
  data-due={payDueText}
  data-card-percent={cardFee.percent}
  data-card-flat={cardFee.flat}
>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div role="group" aria-label="Choose a view" class="flex flex-wrap gap-2">
      <button type="button" class="filter-chip" data-tab="pay" aria-pressed="true">Pay rent</button>
      <button type="button" class="filter-chip" data-tab="account" aria-pressed="false">Autopay and receipts</button>
    </div>
    <p class="rounded-full bg-glow px-3 py-1 text-xs font-bold uppercase tracking-wide text-ink">Design sample: no real payments</p>
  </div>

  <ol class="mt-8 grid grid-cols-3 gap-2 text-sm font-semibold" data-stepper aria-label="Progress">
    {['Your home', 'How to pay', 'Review'].map((label, i) => (
      <li class="step" data-step={i + 1}>
        <span class="step-dot">{i + 1}</span>
        <span>{label}</span>
      </li>
    ))}
  </ol>

  <div class="mt-6">
    <!-- Step 1: home -->
    <form data-panel="home" data-form="home" novalidate class="card space-y-6 p-6 md:p-9">
      <h2 tabindex="-1" data-heading class="text-2xl sm:text-3xl">Find your home</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="pay-name" class="label">Your name</label>
          <input id="pay-name" name="name" type="text" class="input" autocomplete="name" required maxlength="80" />
          <p class="field-error" id="pay-name-error" hidden></p>
        </div>
        <div>
          <label for="pay-unit" class="label">Your unit</label>
          <select id="pay-unit" name="unit" class="input" required>
            <option value="">Choose your unit</option>
            {payUnits.map((u) => <option value={u.id}>{u.label}</option>)}
          </select>
          <p class="field-error" id="pay-unit-error" hidden></p>
        </div>
      </div>
      <div class="rounded-2xl bg-mist p-5" data-rent-card hidden>
        <p class="text-sm font-semibold text-muted">Rent due <span data-bind="due"></span></p>
        <p class="font-display text-4xl font-bold text-lake" data-bind="rent"></p>
      </div>
      <button type="submit" class="btn btn-lake w-full sm:w-auto">Continue</button>
    </form>

    <!-- Step 2: method -->
    <form data-panel="method" data-form="method" hidden novalidate class="card space-y-6 p-6 md:p-9">
      <h2 tabindex="-1" data-heading class="text-2xl sm:text-3xl">How would you like to pay?</h2>
      <fieldset class="space-y-3">
        <legend class="sr-only">Payment method</legend>
        <label class="choice flex-wrap sm:flex-nowrap">
          <input type="radio" name="method" value="bank" checked class="mt-1 h-5 w-5 accent-[#0F3B4C]" />
          <Icon name="bank" class="mt-0.5 h-6 w-6 shrink-0 text-lake" />
          <span class="min-w-0 grow basis-32">
            <span class="block font-display text-xl font-bold text-lake">Bank transfer</span>
            <span class="block text-[0.97rem]">Pay from your checking account. No fee to you.</span>
            <span class="mt-1 inline-block rounded-full bg-glow px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide text-ink">Recommended</span>
          </span>
          <span class="basis-full pl-[4.75rem] font-display text-xl font-bold text-lake sm:basis-auto sm:pl-0 sm:text-right" data-bind="total-bank"></span>
        </label>
        <label class="choice flex-wrap sm:flex-nowrap">
          <input type="radio" name="method" value="card" class="mt-1 h-5 w-5 accent-[#0F3B4C]" />
          <Icon name="card" class="mt-0.5 h-6 w-6 shrink-0 text-lake" />
          <span class="min-w-0 grow basis-32">
            <span class="block font-display text-xl font-bold text-lake">Debit or credit card</span>
            <span class="block text-[0.97rem]">A card fee of <span data-bind="fee-card"></span> is added.</span>
          </span>
          <span class="basis-full pl-[4.75rem] font-display text-xl font-bold text-lake sm:basis-auto sm:pl-0 sm:text-right" data-bind="total-card"></span>
        </label>
      </fieldset>
      <div class="flex flex-col gap-3 sm:flex-row">
        <button type="button" class="btn btn-line" data-go="home">Back</button>
        <button type="submit" class="btn btn-lake">Continue</button>
      </div>
    </form>

    <!-- Step 3: review -->
    <section data-panel="review" hidden class="card space-y-6 p-6 md:p-9">
      <h2 tabindex="-1" data-heading class="text-2xl sm:text-3xl">Review your payment</h2>
      <dl class="divide-y divide-sky rounded-2xl border border-sky">
        <div class="flex justify-between gap-4 p-4"><dt class="text-muted">Home</dt><dd class="font-semibold" data-bind="home"></dd></div>
        <div class="flex justify-between gap-4 p-4"><dt class="text-muted">Name</dt><dd class="font-semibold" data-bind="name"></dd></div>
        <div class="flex justify-between gap-4 p-4"><dt class="text-muted">Paying by</dt><dd class="font-semibold" data-bind="method"></dd></div>
        <div class="flex justify-between gap-4 p-4"><dt class="text-muted">Rent</dt><dd class="font-semibold" data-bind="rent"></dd></div>
        <div class="flex justify-between gap-4 p-4"><dt class="text-muted">Fee</dt><dd class="font-semibold" data-bind="fee"></dd></div>
        <div class="flex justify-between gap-4 bg-mist p-4"><dt class="font-bold">Total</dt><dd class="font-display text-2xl font-bold text-lake" data-bind="total"></dd></div>
      </dl>
      <div class="flex flex-col gap-3 sm:flex-row">
        <button type="button" class="btn btn-line" data-go="method">Back</button>
        <button type="button" class="btn btn-glow" data-go="checkout"><Icon name="lock" class="h-5 w-5" />Continue to secure checkout</button>
      </div>
      <p class="text-sm text-muted">In the real site you are sent to a payment page hosted by Stripe. Your bank or card details are entered there, never on this website.</p>
    </section>

    <!-- Checkout (sample of the page Stripe hosts) -->
    <section data-panel="checkout" hidden class="overflow-hidden rounded-3xl border border-sky" style="box-shadow: 0 18px 40px -28px var(--lake)">
      <div class="flex items-center gap-2 bg-mist px-4 py-2.5 text-sm font-semibold text-lake">
        <Icon name="lock" class="h-4 w-4" />
        <span>Sample of the secure page Stripe hosts</span>
      </div>
      <div class="grid md:grid-cols-[0.9fr_1.1fr]">
        <div class="on-dark hero-bg p-7 text-white md:p-9">
          <h2 tabindex="-1" data-heading class="text-xl text-white">{site.name}</h2>
          <p class="mt-1 text-sky">Pay rent for <span data-bind="home"></span></p>
          <p class="mt-6 font-display text-5xl font-bold text-white" data-bind="total"></p>
          <dl class="mt-8 space-y-2 border-t border-white/20 pt-4 text-[0.97rem] text-sky">
            <div class="flex justify-between"><dt>Rent</dt><dd data-bind="rent"></dd></div>
            <div class="flex justify-between"><dt>Fee</dt><dd data-bind="fee"></dd></div>
          </dl>
        </div>
        <form data-form="checkout" novalidate class="space-y-5 bg-white p-7 md:p-9">
          <div>
            <label for="pay-email" class="label">Email for your receipt</label>
            <input id="pay-email" name="email" type="email" class="input" autocomplete="email" required maxlength="120" />
            <p class="field-error" id="pay-email-error" hidden></p>
          </div>
          <div data-pay-bank class="space-y-3">
            <p class="label">Pay with your bank</p>
            <button type="button" class="btn btn-line w-full" data-connect><Icon name="bank" class="h-5 w-5" /><span data-connect-label>Connect your bank</span></button>
            <p class="text-sm text-muted">You choose your bank and sign in on a secure screen. This sample uses a pretend account.</p>
          </div>
          <div data-pay-card class="space-y-3" hidden>
            <p class="label">Card details</p>
            <input class="input" disabled placeholder="1234 1234 1234 1234" aria-label="Card number (sample, disabled)" />
            <div class="grid grid-cols-2 gap-3">
              <input class="input" disabled placeholder="MM / YY" aria-label="Expiry (sample, disabled)" />
              <input class="input" disabled placeholder="CVC" aria-label="CVC (sample, disabled)" />
            </div>
            <p class="text-sm text-muted">Sample only: these fields are switched off and never collect anything.</p>
          </div>
          <p class="field-error" id="pay-bank-error" hidden></p>
          <button type="submit" class="btn btn-lake w-full"><Icon name="lock" class="h-5 w-5" />Pay <span data-bind="total"></span></button>
          <button type="button" class="block w-full text-center text-sm font-semibold text-lake underline" data-go="review">Back to review</button>
        </form>
      </div>
    </section>

    <!-- Receipt -->
    <section data-panel="receipt" hidden class="card space-y-6 p-6 text-center md:p-10">
      <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-lake text-white"><Icon name="check" class="h-8 w-8" /></span>
      <div>
        <h2 tabindex="-1" data-heading class="text-3xl sm:text-4xl">Payment received</h2>
        <p class="mt-2 text-lg">Thank you, <span data-bind="first"></span>. A receipt was sent to <strong data-bind="email"></strong>.</p>
      </div>
      <dl class="mx-auto max-w-sm divide-y divide-sky rounded-2xl border border-sky text-left">
        <div class="flex justify-between gap-4 p-4"><dt class="text-muted">Home</dt><dd class="font-semibold" data-bind="home"></dd></div>
        <div class="flex justify-between gap-4 p-4"><dt class="text-muted">Paid</dt><dd class="font-semibold" data-bind="total"></dd></div>
        <div class="flex justify-between gap-4 p-4"><dt class="text-muted">Date</dt><dd class="font-semibold" data-bind="today"></dd></div>
        <div class="flex justify-between gap-4 p-4"><dt class="text-muted">Confirmation</dt><dd class="font-semibold">SAMPLE-1042</dd></div>
      </dl>
      <div class="flex flex-col justify-center gap-3 sm:flex-row">
        <button type="button" class="btn btn-glow" data-go="signin"><Icon name="repeat" class="h-5 w-5" />Set up autopay</button>
        <button type="button" class="btn btn-line" data-go="home">Make another payment</button>
      </div>
    </section>

    <!-- Account: sign in with an email code (sample of Stripe's hosted customer portal) -->
    <form data-panel="signin" data-form="signin" hidden novalidate class="card space-y-6 p-6 md:p-9">
      <div>
        <h2 tabindex="-1" data-heading class="text-2xl sm:text-3xl">Autopay and receipts</h2>
        <p class="mt-2 text-lg">Enter the email you pay with. We send a one time code, so there is no password to remember.</p>
      </div>
      <div>
        <label for="acct-email" class="label">Email</label>
        <input id="acct-email" name="email" type="email" class="input" autocomplete="email" required maxlength="120" />
        <p class="field-error" id="acct-email-error" hidden></p>
      </div>
      <button type="submit" class="btn btn-lake w-full sm:w-auto">Email me a code</button>
    </form>

    <form data-panel="code" data-form="code" hidden novalidate class="card space-y-6 p-6 md:p-9">
      <div>
        <h2 tabindex="-1" data-heading class="text-2xl sm:text-3xl">Check your email</h2>
        <p class="mt-2 text-lg">We sent a 6 digit code to <strong data-bind="email"></strong>.</p>
      </div>
      <div>
        <label for="acct-code" class="label">6 digit code</label>
        <input id="acct-code" name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" class="input max-w-[12rem] tracking-[0.4em]" autocomplete="one-time-code" required />
        <span class="hint">Sample: any 6 digits work.</span>
        <p class="field-error" id="acct-code-error" hidden></p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <button type="button" class="btn btn-line" data-go="signin">Back</button>
        <button type="submit" class="btn btn-lake">Sign in</button>
      </div>
    </form>

    <section data-panel="account" hidden class="space-y-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 tabindex="-1" data-heading class="text-2xl sm:text-3xl">Your account</h2>
          <p class="text-muted">Signed in as <span data-bind="email"></span></p>
        </div>
        <button type="button" class="btn btn-line !min-h-[44px]" data-signout>Sign out</button>
      </div>

      <div class="card flex items-center justify-between gap-5 p-6">
        <div>
          <p class="font-display text-xl font-bold text-lake">Autopay</p>
          <p class="mt-1" data-autopay-text></p>
        </div>
        <button type="button" role="switch" aria-checked="false" aria-label="Autopay" class="switch" data-autopay><span></span></button>
      </div>

      <div class="card p-6">
        <p class="font-display text-xl font-bold text-lake">Payment method</p>
        <p class="mt-1 flex items-center gap-2"><Icon name="bank" class="h-5 w-5 text-lake" />Sample Bank, checking ending in 6789</p>
        <button type="button" class="btn btn-line mt-4 !min-h-[44px] cursor-not-allowed opacity-60" disabled>Update payment method</button>
      </div>

      <div class="card overflow-hidden">
        <p class="px-6 pt-6 font-display text-xl font-bold text-lake">Payment history</p>
        <div class="overflow-x-auto p-2 pb-4">
          <table class="w-full min-w-[30rem] text-left">
            <caption class="sr-only">Sample payment history</caption>
            <thead>
              <tr class="text-sm text-muted">
                <th scope="col" class="px-4 py-2 font-semibold">Date</th>
                <th scope="col" class="px-4 py-2 font-semibold">Method</th>
                <th scope="col" class="px-4 py-2 font-semibold">Amount</th>
                <th scope="col" class="px-4 py-2 font-semibold">Status</th>
              </tr>
            </thead>
            <tbody>
              {payHistory.map((p) => (
                <tr class="border-t border-sky">
                  <td class="px-4 py-3">{p.date}</td>
                  <td class="px-4 py-3">{p.method}</td>
                  <td class="px-4 py-3 font-semibold">{money(p.amount)}</td>
                  <td class="px-4 py-3"><span class="rounded-full bg-mist px-3 py-1 text-sm font-semibold text-lake">{p.status}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <noscript>
    <p class="mt-6 rounded-2xl border-2 border-glow bg-[#FFF6E0] p-5">Turn on JavaScript to try the sample payment screens, or call <a href={phoneHref} class="font-semibold text-lake underline">{managerName} at {site.phone}</a>.</p>
  </noscript>
</div>

<script>
  import { cleanLine } from '../lib/sanitize';

  const app = document.getElementById('pay-app');
  if (app) {
    type Unit = { id: string; label: string; rent: number };
    const units: Unit[] = JSON.parse(app.dataset.units ?? '[]');
    const due = app.dataset.due ?? '';
    const percent = Number(app.dataset.cardPercent);
    const flat = Number(app.dataset.cardFlat);
    const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
    const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const state = { unit: null as Unit | null, name: '', method: 'bank' as 'bank' | 'card', email: '', bank: false, autopay: false, signedIn: false };

    const panels = [...app.querySelectorAll<HTMLElement>('[data-panel]')];
    const payPanels = ['home', 'method', 'review', 'checkout', 'receipt'];
    const stepOf: Record<string, number> = { home: 1, method: 2, review: 3 };

    const feeFor = (rent: number, method: 'bank' | 'card') => (method === 'card' ? Math.round((rent * percent + flat) * 100) / 100 : 0);

    function bind(key: string, value: string) {
      app!.querySelectorAll<HTMLElement>(`[data-bind="${key}"]`).forEach((n) => (n.textContent = value));
    }

    function refresh() {
      const u = state.unit;
      if (!u) return;
      const fee = feeFor(u.rent, state.method);
      bind('due', due);
      bind('rent', usd.format(u.rent));
      bind('fee-card', usd.format(feeFor(u.rent, 'card')));
      bind('total-bank', usd.format(u.rent));
      bind('total-card', usd.format(u.rent + feeFor(u.rent, 'card')));
      bind('home', u.label);
      bind('name', state.name);
      bind('first', state.name.split(' ')[0] ?? '');
      bind('method', state.method === 'bank' ? 'Bank transfer' : 'Card');
      bind('fee', fee ? usd.format(fee) : 'None');
      bind('total', usd.format(u.rent + fee));
      bind('email', state.email);
      bind('today', new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }));
      app!.querySelector<HTMLElement>('[data-pay-bank]')!.hidden = state.method !== 'bank';
      app!.querySelector<HTMLElement>('[data-pay-card]')!.hidden = state.method !== 'card';
    }

    function showPanel(name: string, initial = false) {
      refresh();
      panels.forEach((p) => (p.hidden = p.dataset.panel !== name));
      const inPay = payPanels.includes(name);
      app!.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) => t.setAttribute('aria-pressed', String((t.dataset.tab === 'pay') === inPay)));
      const stepper = app!.querySelector<HTMLElement>('[data-stepper]')!;
      stepper.hidden = !(name in stepOf);
      stepper.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => {
        const n = Number(s.dataset.step);
        s.setAttribute('data-state', n < stepOf[name] ? 'done' : n === stepOf[name] ? 'current' : 'todo');
        if (n === stepOf[name]) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
      });
      if (initial) return; // do not scroll or move focus on page load
      const panel = panels.find((p) => p.dataset.panel === name)!;
      app!.scrollIntoView({ block: 'start', behavior: reduce() ? 'auto' : 'smooth' });
      panel.querySelector<HTMLElement>('[data-heading]')?.focus({ preventScroll: true });
    }

    /** Shows an error under a field and moves focus to it. */
    function fail(input: HTMLElement, msg: string) {
      const err = document.getElementById(`${input.id}-error`)!;
      err.textContent = msg;
      err.hidden = false;
      input.setAttribute('aria-invalid', 'true');
      input.setAttribute('aria-describedby', err.id);
      input.focus();
    }
    function reset(form: HTMLFormElement) {
      form.querySelectorAll<HTMLElement>('input, select').forEach((i) => {
        i.removeAttribute('aria-invalid');
        i.removeAttribute('aria-describedby');
      });
      form.querySelectorAll<HTMLElement>('.field-error').forEach((e) => {
        e.hidden = true;
        e.textContent = '';
      });
    }
    const validEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);

    function renderAutopay() {
      const sw = app!.querySelector<HTMLElement>('[data-autopay]')!;
      sw.setAttribute('aria-checked', String(state.autopay));
      const rent = state.unit ? usd.format(state.unit.rent) : usd.format(700);
      app!.querySelector<HTMLElement>('[data-autopay-text]')!.textContent = state.autopay
        ? `On. ${rent} is paid from Sample Bank on the 1st of each month, and a receipt is emailed.`
        : 'Off. Turn it on and rent is paid on time every month.';
    }

    // Unit picker shows the rent right away.
    app.querySelector<HTMLSelectElement>('#pay-unit')!.addEventListener('change', (e) => {
      const u = units.find((x) => x.id === (e.target as HTMLSelectElement).value) ?? null;
      state.unit = u;
      app!.querySelector<HTMLElement>('[data-rent-card]')!.hidden = !u;
      refresh();
    });

    app.querySelectorAll<HTMLInputElement>('input[name="method"]').forEach((r) =>
      r.addEventListener('change', () => {
        state.method = r.value === 'card' ? 'card' : 'bank';
        refresh();
      }),
    );

    app.addEventListener('click', (e) => {
      const t = e.target as Element;
      const tab = t.closest<HTMLElement>('[data-tab]');
      if (tab) return showPanel(tab.dataset.tab === 'pay' ? 'home' : state.signedIn ? 'account' : 'signin');
      const go = t.closest<HTMLElement>('[data-go]');
      if (go) {
        if (go.dataset.go === 'signin') (app!.querySelector<HTMLInputElement>('#acct-email')!).value = state.email;
        return showPanel(go.dataset.go!);
      }
      if (t.closest('[data-connect]')) {
        state.bank = true;
        app!.querySelector<HTMLElement>('[data-connect-label]')!.textContent = 'Connected, ending 6789';
        const err = document.getElementById('pay-bank-error')!;
        err.hidden = true;
        return;
      }
      if (t.closest('[data-autopay]')) {
        state.autopay = !state.autopay;
        return renderAutopay();
      }
      if (t.closest('[data-signout]')) {
        state.autopay = false;
        state.signedIn = false;
        renderAutopay();
        return showPanel('signin');
      }
    });

    app.addEventListener('submit', (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      reset(form);
      const val = (n: string) => cleanLine((form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '', 120);

      switch (form.dataset.form) {
        case 'home': {
          const name = val('name');
          const unit = units.find((u) => u.id === val('unit'));
          // Show both errors, then focus the first field that has one.
          if (!unit) fail(form.querySelector<HTMLElement>('#pay-unit')!, 'Choose your unit.');
          if (name.length < 2) fail(form.querySelector<HTMLElement>('#pay-name')!, 'Enter your name.');
          if (name.length < 2 || !unit) return;
          Object.assign(state, { name, unit });
          return showPanel('method');
        }
        case 'method':
          return showPanel('review');
        case 'checkout': {
          const email = val('email');
          if (!validEmail(email)) return fail(form.querySelector<HTMLElement>('#pay-email')!, 'Enter a valid email address.');
          if (state.method === 'bank' && !state.bank) {
            const err = document.getElementById('pay-bank-error')!;
            err.textContent = 'Connect your bank to continue.';
            err.hidden = false;
            return;
          }
          state.email = email;
          return showPanel('receipt');
        }
        case 'signin': {
          const email = val('email');
          if (!validEmail(email)) return fail(form.querySelector<HTMLElement>('#acct-email')!, 'Enter a valid email address.');
          state.email = email;
          return showPanel('code');
        }
        case 'code': {
          if (!/^\d{6}$/.test(val('code'))) return fail(form.querySelector<HTMLElement>('#acct-code')!, 'Enter the 6 digit code.');
          form.reset();
          state.signedIn = true;
          renderAutopay();
          return showPanel('account');
        }
      }
    });

    renderAutopay();
    showPanel('home', true);
  }
</script>
