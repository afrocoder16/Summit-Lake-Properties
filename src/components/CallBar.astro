---
import { site, phoneHref, managerName } from '../config/site';
import Icon from './Icon.astro';
---
<div class="fixed inset-x-0 bottom-0 z-50 border-t border-black/10 bg-glow p-2 md:hidden">
  <a href={phoneHref} class="flex min-h-[52px] items-center justify-center gap-2 rounded-full bg-ink px-5 text-base font-semibold text-white">
    <Icon name="phone" class="h-5 w-5" />
    Call us {site.phone}
  </a>
</div>
