---
import { site, phoneHref, managerName } from '../config/site';
import { inquiryConfigured } from '../config/env';
import { CONTACT_TIMES, TOUR_DAYS, INQUIRY_LIMITS } from '../lib/validate';

interface Props {
  /** Short id used to keep field ids unique when several forms are on one page. */
  id: string;
  unitLabel: string;
  rent: string;
}
const { id, unitLabel, rent } = Astro.props;
const fid = (name: string) => `${id}-${name}`;
---
<form
  data-inquiry-form
  data-unit={unitLabel}
  data-rent={rent}
  data-phone={site.phone}
  data-tel={phoneHref}
  data-manager={managerName}
  data-configured={String(inquiryConfigured)}
  novalidate
  autocomplete="on"
  class="mt-6 space-y-5"
  aria-labelledby={fid('form-title')}
>
  <h3 id={fid('form-title')} class="text-xl">Send {managerName} a message</h3>

  <div class="hp" aria-hidden="true">
    <label for={fid('company')}>Leave this field empty</label>
    <input type="text" id={fid('company')} name="company" tabindex="-1" autocomplete="off" />
  </div>

  <fieldset>
    <legend class="sr-only">What would you like to do?</legend>
    <div class="grid grid-cols-2 gap-2 rounded-full bg-mist p-1">
      <label class="segment">
        <input type="radio" name="kind" value="question" checked class="sr-only" />
        <span>Ask a question</span>
      </label>
      <label class="segment">
        <input type="radio" name="kind" value="tour" class="sr-only" />
        <span>Request a tour</span>
      </label>
    </div>
  </fieldset>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for={fid('name')} class="label">Your name</label>
      <input id={fid('name')} name="name" type="text" class="input" autocomplete="name" required maxlength={INQUIRY_LIMITS.name} />
      <p class="field-error" id={fid('name-error')} data-error="name" hidden></p>
    </div>
    <div>
      <label for={fid('phone')} class="label">Phone number</label>
      <input id={fid('phone')} name="phone" type="tel" inputmode="tel" class="input" autocomplete="tel" required maxlength={INQUIRY_LIMITS.phone} />
      <p class="field-error" id={fid('phone-error')} data-error="phone" hidden></p>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2" data-tour-fields hidden>
    <div>
      <label for={fid('tourDay')} class="label">Best day to visit</label>
      <select id={fid('tourDay')} name="tourDay" class="input">
        {TOUR_DAYS.map((d) => <option value={d}>{d}</option>)}
      </select>
      <p class="field-error" id={fid('tourDay-error')} data-error="tourDay" hidden></p>
    </div>
    <div>
      <label for={fid('contactTime')} class="label">Best time</label>
      <select id={fid('contactTime')} name="contactTime" class="input">
        {CONTACT_TIMES.map((t) => <option value={t}>{t}</option>)}
      </select>
      <p class="field-error" id={fid('contactTime-error')} data-error="contactTime" hidden></p>
    </div>
  </div>

  <div>
    <label for={fid('message')} class="label">
      <span data-message-label>Your question</span>
      <span class="font-normal text-muted" data-message-optional hidden>(optional)</span>
    </label>
    <textarea id={fid('message')} name="message" rows="3" class="input" maxlength={INQUIRY_LIMITS.message}></textarea>
    <p class="field-error" id={fid('message-error')} data-error="message" hidden></p>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <button type="submit" class="btn btn-lake w-full sm:w-auto sm:min-w-[200px]" data-submit>
      <span data-submit-label>Send message</span>
    </button>
    <p class="text-[0.95rem]">Or call <a href={phoneHref} class="whitespace-nowrap font-semibold text-lake underline">{managerName} at {site.phone}</a></p>
  </div>

  <div data-status tabindex="-1" aria-live="polite" class="rounded-2xl outline-offset-4" hidden></div>
</form>

<script>
  import { validateInquiry, type InquiryInput } from '../lib/validate';

  const COOLDOWN_MS = 30_000;
  const COOLDOWN_KEY = 'slp-inquiry-last';
  const fields = ['name', 'phone', 'tourDay', 'contactTime', 'message'] as const;

  const kindOf = (form: HTMLFormElement) =>
    (form.querySelector<HTMLInputElement>('input[name="kind"]:checked')?.value === 'tour' ? 'tour' : 'question');

  function syncKind(form: HTMLFormElement) {
    const tour = kindOf(form) === 'tour';
    form.querySelector<HTMLElement>('[data-tour-fields]')!.hidden = !tour;
    form.querySelector<HTMLElement>('[data-message-optional]')!.hidden = !tour;
    form.querySelector<HTMLElement>('[data-message-label]')!.textContent = tour ? 'Anything we should know?' : 'Your question';
    form.querySelector<HTMLElement>('[data-submit-label]')!.textContent = tour ? 'Request tour' : 'Send message';
  }

  document.addEventListener('change', (e) => {
    const form = (e.target as Element).closest<HTMLFormElement>('[data-inquiry-form]');
    if (form && (e.target as HTMLInputElement).name === 'kind') syncKind(form);
  });

  function showStatus(form: HTMLFormElement, kind: 'success' | 'error' | 'info', title: string, body: string) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    status.hidden = false;
    status.setAttribute('role', kind === 'error' ? 'alert' : 'status');
    status.className =
      'rounded-2xl border-2 p-5 ' +
      (kind === 'success'
        ? 'border-shore bg-mist text-ink'
        : kind === 'error'
          ? 'border-[#B3261E] bg-[#FDECEA] text-ink'
          : 'border-glow bg-[#FFF6E0] text-ink');
    const h = document.createElement('p');
    h.className = 'font-display text-xl font-bold';
    h.textContent = title;
    const a = document.createElement('a');
    a.href = form.dataset.tel ?? '#';
    a.textContent = `${form.dataset.manager} at ${form.dataset.phone}`;
    a.className = 'font-semibold underline';
    const p = document.createElement('p');
    p.className = 'mt-1';
    p.append(body + ' You can also call ', a, '.');
    status.replaceChildren(h, p);
    status.focus();
  }

  function clearErrors(form: HTMLFormElement) {
    for (const f of fields) {
      const err = form.querySelector<HTMLElement>(`[data-error="${f}"]`)!;
      const input = form.elements.namedItem(f) as HTMLElement;
      err.hidden = true;
      err.textContent = '';
      input.removeAttribute('aria-invalid');
      input.removeAttribute('aria-describedby');
    }
  }

  function showErrors(form: HTMLFormElement, errors: Partial<Record<keyof InquiryInput, string>>) {
    let first: HTMLElement | null = null;
    for (const f of fields) {
      const msg = errors[f];
      if (!msg) continue;
      const err = form.querySelector<HTMLElement>(`[data-error="${f}"]`)!;
      const input = form.elements.namedItem(f) as HTMLElement;
      err.textContent = msg;
      err.hidden = false;
      input.setAttribute('aria-invalid', 'true');
      input.setAttribute('aria-describedby', err.id);
      first ??= input;
    }
    first?.focus();
  }

  document.addEventListener('submit', async (e) => {
    const form = (e.target as Element).closest<HTMLFormElement>('[data-inquiry-form]');
    if (!form) return;
    e.preventDefault();
    form.querySelector<HTMLElement>('[data-status]')!.hidden = true;
    clearErrors(form);

    const data = Object.fromEntries(new FormData(form));

    // Honeypot: bots fill it, people never see it. Pretend success and send nothing.
    if (String(data.company ?? '').trim() !== '') {
      showStatus(form, 'success', 'Message sent', 'Thank you.');
      form.reset();
      syncKind(form);
      return;
    }

    const { values, errors } = validateInquiry(data);
    if (Object.keys(errors).length) return showErrors(form, errors);

    try {
      if (Date.now() - Number(localStorage.getItem(COOLDOWN_KEY) ?? 0) < COOLDOWN_MS) {
        return showStatus(form, 'info', 'One moment', 'Please wait a few seconds before sending another message.');
      }
    } catch {
      /* storage unavailable, skip the cooldown */
    }

    if (form.dataset.configured !== 'true') {
      return showStatus(
        form,
        'info',
        'Sample mode: nothing was sent',
        'This is a sample website and the email service is not connected yet.',
      );
    }

    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = submit.querySelector<HTMLElement>('[data-submit-label]')!;
    const idle = label.textContent;
    submit.disabled = true;
    label.textContent = 'Sending...';
    try {
      const emailjs = (await import('@emailjs/browser')).default;
      const tour = values.kind === 'tour';
      await emailjs.send(
        import.meta.env.PUBLIC_EMAILJS_SERVICE_ID,
        import.meta.env.PUBLIC_EMAILJS_INQUIRY_TEMPLATE_ID,
        {
          request_type: tour ? 'Tour request' : 'Question',
          from_name: values.name,
          phone: values.phone,
          unit: form.dataset.unit ?? '',
          rent: form.dataset.rent ?? '',
          preferred_time: tour ? `${values.tourDay}, ${values.contactTime}` : 'Not given',
          message: values.message || 'None',
          submitted_at: new Date().toLocaleString('en-US', { timeZone: 'America/Chicago' }),
        },
        { publicKey: import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY },
      );
      try { localStorage.setItem(COOLDOWN_KEY, String(Date.now())); } catch { /* ignore */ }
      form.reset();
      syncKind(form);
      showStatus(
        form,
        'success',
        tour ? 'Tour request sent' : 'Message sent',
        `Thank you, ${values.name.split(' ')[0]}. ${form.dataset.manager} will get back to you.`,
      );
    } catch {
      showStatus(form, 'error', 'We could not send your message', 'Please try again in a moment.');
    } finally {
      submit.disabled = false;
      label.textContent = idle;
    }
  });
</script>
