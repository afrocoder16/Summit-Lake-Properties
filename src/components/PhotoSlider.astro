---
import Icon from './Icon.astro';
import { href } from '../config/site';
import type { SamplePhoto } from '../config/sample';

interface Props {
  photos: SamplePhoto[];
  /** Names the carousel for screen readers, for example "Photos of Sample 2A". */
  label: string;
  /** Show a thumbnail strip under the photo (used in the full screen viewer). */
  thumbs?: boolean;
  /** Load the first photo right away. Later photos always load lazily. */
  eager?: boolean;
}
const { photos, label, thumbs = false, eager = false } = Astro.props;
---
<div class="relative" data-slider role="region" aria-roledescription="carousel" aria-label={label}>
  <div class="relative">
    <div class="slider-track aspect-[3/2] bg-sky" data-track tabindex="0" aria-label={`${label}, use the arrow keys to move between photos`}>
      {photos.map((p, i) => (
        <div class="slider-slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${photos.length}`}>
          <img
            src={href(p.src)}
            alt={p.alt}
            width="1200"
            height="800"
            loading={i === 0 && eager ? 'eager' : 'lazy'}
            decoding="async"
            draggable="false"
          />
        </div>
      ))}
    </div>
    {photos.length > 1 && (
      <>
        <button type="button" class="slider-btn left-3" data-prev aria-label="Previous photo" aria-disabled="true">
          <Icon name="chevron-left" class="h-6 w-6" />
        </button>
        <button type="button" class="slider-btn right-3" data-next aria-label="Next photo">
          <Icon name="chevron-right" class="h-6 w-6" />
        </button>
      </>
    )}
    <p class="absolute bottom-3 right-3 rounded-full px-3 py-1 text-sm font-semibold text-white" style="background: color-mix(in srgb, var(--ink) 82%, transparent)" data-count aria-live="polite">
      1 of {photos.length}
    </p>
  </div>

  {thumbs && photos.length > 1 && (
    <ul class="mt-3 grid grid-cols-4 gap-2 sm:gap-3" aria-label="Choose a photo">
      {photos.map((p, i) => (
        <li>
          <button type="button" data-thumb={i} class="thumb-btn" aria-label={`Show photo ${i + 1} of ${photos.length}`} aria-current={i === 0 ? 'true' : 'false'}>
            <img src={href(p.src)} alt="" width="300" height="200" loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover" />
          </button>
        </li>
      ))}
    </ul>
  )}
</div>

<script>
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const parts = (root: HTMLElement) => ({
    track: root.querySelector<HTMLElement>('[data-track]')!,
    prev: root.querySelector<HTMLElement>('[data-prev]'),
    next: root.querySelector<HTMLElement>('[data-next]'),
    count: root.querySelector<HTMLElement>('[data-count]'),
    thumbs: root.querySelectorAll<HTMLElement>('[data-thumb]'),
  });

  function update(root: HTMLElement) {
    const { track, prev, next, count, thumbs } = parts(root);
    const total = track.children.length;
    if (!track.clientWidth) return; // hidden (closed dialog)
    const i = Math.min(total - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));
    if (count) count.textContent = `${i + 1} of ${total}`;
    prev?.setAttribute('aria-disabled', String(i === 0));
    next?.setAttribute('aria-disabled', String(i === total - 1));
    thumbs.forEach((t, n) => t.setAttribute('aria-current', String(n === i)));
  }

  function go(root: HTMLElement, i: number) {
    const { track } = parts(root);
    const total = track.children.length;
    const to = Math.min(total - 1, Math.max(0, i));
    track.scrollTo({ left: to * track.clientWidth, behavior: reduce() ? 'auto' : 'smooth' });
  }

  const current = (root: HTMLElement) => {
    const { track } = parts(root);
    return Math.round(track.scrollLeft / (track.clientWidth || 1));
  };

  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    const root = t.closest<HTMLElement>('[data-slider]');
    if (!root) return;
    if (t.closest('[data-prev]')) go(root, current(root) - 1);
    else if (t.closest('[data-next]')) go(root, current(root) + 1);
    else {
      const thumb = t.closest<HTMLElement>('[data-thumb]');
      if (thumb) go(root, Number(thumb.dataset.thumb));
    }
  });

  document.addEventListener('keydown', (e) => {
    const track = (e.target as Element).closest<HTMLElement>('[data-track]');
    const root = track?.closest<HTMLElement>('[data-slider]');
    if (!root || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
    e.preventDefault();
    go(root, current(root) + (e.key === 'ArrowRight' ? 1 : -1));
  });

  // scroll does not bubble, so listen in the capture phase.
  let frame = 0;
  document.addEventListener(
    'scroll',
    (e) => {
      const track = e.target instanceof HTMLElement && e.target.matches('[data-track]') ? e.target : null;
      const root = track?.closest<HTMLElement>('[data-slider]');
      if (!root) return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => update(root));
    },
    true,
  );
</script>
