---
import { site } from '../config/site';
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  {site.logo ? (
    <img src={site.logo.src} alt={site.logo.alt} class="h-9 w-auto" />
  ) : (
    <>
      <svg viewBox="0 0 40 40" class="h-9 w-9 shrink-0" aria-hidden="true" focusable="false">
        <rect width="40" height="40" rx="11" fill="var(--lake)" />
        <path d="M6 27 16 11l6 9 3-4 9 11z" fill="var(--mist)" />
        <circle cx="29" cy="11" r="3" fill="var(--glow)" />
        <path d="M5 32c3-2 5-2 8 0s5 2 8 0 5-2 8 0 4 1 6 0" stroke="var(--shore)" stroke-width="2" fill="none" stroke-linecap="round" />
      </svg>
      <span class="font-display text-[1.05rem] font-bold leading-tight tracking-tight">{site.name}</span>
    </>
  )}
</span>
